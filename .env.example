# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Send email (used by Supabase Edge Functions)
RESEND_API_KEY=
EMAIL_FROM=Loomette <hi@loomette.id>

# OpenRouter (used by Supabase Edge Functions)
OPENROUTER_API_KEY=
# Optional model overrides:
# OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
# OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-flare

# VAPID Public key for push notification
# TODO: Implement push notification
NEXT_PUBLIC_VAPID_KEY=

# Payment Gateway Configuration
# Active provider: "mock" (default) | "midtrans" | "xendit" | "stripe" | "mayar"
PAYMENT_GATEWAY_PROVIDER=mock

# Midtrans (Indonesia)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit (Indonesia / SEA)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Stripe (Global)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mayar (Indonesia)
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
